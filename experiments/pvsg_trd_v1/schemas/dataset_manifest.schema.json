{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dataset_manifest.schema.json",
  "description": "M0 structure contract; cross-field frame/track/visibility checks belong to M1.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "pvsg_dataset_manifest"
    },
    "dataset_id": {
      "const": "pvsg"
    },
    "split_id": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "template",
        "verified_candidate",
        "locked"
      ]
    },
    "selected_by_user": {
      "type": "boolean"
    },
    "ready_for_training": {
      "const": false
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "local_path": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "url",
        "revision",
        "sha256",
        "bytes",
        "local_path"
      ]
    },
    "outer_split": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "train_ids": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            {
              "type": "null"
            }
          ]
        },
        "heldout_ids": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            {
              "type": "null"
            }
          ]
        },
        "expected_counts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "train": {
              "type": "integer",
              "minimum": 1
            },
            "heldout": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "train",
            "heldout"
          ]
        },
        "upstream_heldout_key": {
          "const": "val"
        },
        "heldout_role": {
          "const": "test"
        },
        "split_ids_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "train_ids",
        "heldout_ids",
        "expected_counts",
        "upstream_heldout_key",
        "heldout_role",
        "split_ids_sha256"
      ]
    },
    "video_sources": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "vidor",
          "epic_kitchen",
          "ego4d"
        ]
      }
    },
    "internal_validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "pending",
            "locked"
          ]
        },
        "seed": {
          "const": 17
        },
        "target_fraction": {
          "const": 0.15
        },
        "grouping": {
          "const": "source_session_when_available"
        },
        "fit_ids": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            {
              "type": "null"
            }
          ]
        },
        "validation_ids": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "state",
        "seed",
        "target_fraction",
        "grouping",
        "fit_ids",
        "validation_ids"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "selection_note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "evidence_ids",
        "selection_note"
      ]
    }
  },
  "required": [
    "schema_version",
    "kind",
    "dataset_id",
    "split_id",
    "state",
    "selected_by_user",
    "ready_for_training",
    "annotation",
    "outer_split",
    "video_sources",
    "internal_validation",
    "provenance"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "template"
          }
        }
      },
      "then": {
        "properties": {
          "selected_by_user": {
            "const": false
          },
          "annotation": {
            "properties": {
              "sha256": {
                "type": "null"
              }
            }
          },
          "outer_split": {
            "properties": {
              "train_ids": {
                "type": "null"
              },
              "heldout_ids": {
                "type": "null"
              },
              "split_ids_sha256": {
                "type": "null"
              }
            }
          },
          "video_sources": {
            "maxProperties": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "verified_candidate",
              "locked"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "annotation": {
            "properties": {
              "url": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1
              },
              "local_path": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "outer_split": {
            "properties": {
              "train_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "heldout_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "split_ids_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "video_sources": {
            "minProperties": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "locked"
          }
        }
      },
      "then": {
        "properties": {
          "selected_by_user": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "verified_candidate"
          }
        }
      },
      "then": {
        "properties": {
          "selected_by_user": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "internal_validation": {
            "properties": {
              "state": {
                "const": "pending"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "internal_validation": {
            "properties": {
              "fit_ids": {
                "type": "null"
              },
              "validation_ids": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "internal_validation": {
            "properties": {
              "state": {
                "const": "locked"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "internal_validation": {
            "properties": {
              "fit_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "validation_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              }
            }
          }
        }
      }
    }
  ]
}
