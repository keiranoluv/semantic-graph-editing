{
  "schema_version": 1,
  "protocol_id": "pvsg-gt-trd-tiouv1",
  "status": "frozen_specification",
  "task": "offline_temporal_relation_detection",
  "knowledge_graph": false,
  "input": {
    "gt_masks": true,
    "gt_object_labels": true,
    "gt_track_ids": true,
    "gt_predicates_at_inference": false,
    "gt_relation_pairs_at_inference": false,
    "gt_relation_intervals_at_inference": false,
    "rgb_backbone": "frozen",
    "track_ids_are_features": false,
    "object_class_ids": "zero_based_things_then_stuff",
    "predicate_ids": "zero_based_annotation_vocabulary",
    "object_classes": 126,
    "predicates": 57,
    "annotation_fps": 5,
    "captions_qa_summaries_used": false
  },
  "temporal": {
    "frame_index_base": 0,
    "interval_end": "inclusive",
    "timestamp_seconds": "[start/5, (end+1)/5)",
    "overlapping_or_adjacent_intervals": "union",
    "gt_support": "annotated_frames_intersect_subject_and_object_visibility",
    "prediction_support": "predicted_frames_intersect_subject_and_object_visibility",
    "clip_prediction_to_gt_relation_interval": false,
    "empty_gt_after_visibility": "fail_data_audit_do_not_silently_drop",
    "invalid_frame_or_unknown_track": "error"
  },
  "candidates": {
    "ordered": true,
    "self_pairs": false,
    "rule": "all_track_pairs_with_at_least_one_covisible_frame",
    "restrict_to_annotated_pairs": false,
    "graph_constraint": false
  },
  "output": {
    "unit": "video_subject_predicate_object_with_union_of_intervals",
    "multi_label": true,
    "empty_prediction_list": "allowed",
    "duplicate_predictions": "merge_interval_union_and_max_score",
    "duplicate_gt": "merge_interval_union",
    "rank_scope": "whole_video_after_window_merge",
    "tie_break": ["score_descending", "subject_id_ascending", "predicate_id_ascending", "object_id_ascending"]
  },
  "decoder": {
    "window_merge": "mean_logits_at_original_frame_indices_before_sigmoid",
    "activation": "sigmoid",
    "threshold": 0.5,
    "threshold_comparison": "greater_than_or_equal",
    "gap_merge_frames": 0,
    "min_interval_frames": 1,
    "tuple_score": "mean_probability_over_predicted_active_covisible_frames",
    "empty_active_set": "omit_tuple",
    "changes_require_versioned_run_config": true,
    "tuning_split": "internal_validation_only"
  },
  "metrics": {
    "matching": "exact_ordered_track_ids_and_predicate",
    "iou": "temporal_set_intersection_over_union",
    "ks": [20, 50, 100],
    "tiou_thresholds": [0.3, 0.5, 0.7],
    "primary_tiou_threshold": 0.5,
    "hit_comparison": "greater_than_or_equal",
    "recall_aggregation": "sum_hits_across_videos_divided_by_sum_gt_tuples",
    "mean_recall_aggregation": "mean_class_global_recall_over_classes_with_gt_support",
    "zero_support_class": "exclude_from_mean_report_support_zero",
    "zero_gt_split": "null_metrics",
    "negative_videos": "retain_report_predictions_false_positive_diagnostic",
    "gt_tuple_hit_limit": 1,
    "report_scale": "percent",
    "diagnostics": ["predicate_only_recall", "mean_tiou_at_100_zero_for_missed_gt", "per_class_support", "per_source_support"]
  },
  "selection": {
    "split": "internal_validation",
    "primary": "mR@50_tIoU0.5",
    "tie_break": ["R@50_tIoU0.5", "earliest_epoch"],
    "test_tuning": false,
    "model_seeds": [17, 42, 2026]
  },
  "protocol_boundaries": {
    "not_pvsg_end_to_end": true,
    "not_label_only_oracle": true,
    "not_openpvsg_calculate_viou": true,
    "upstream_compatibility_requires_separate_protocol_id": true,
    "baseline_adaptation_id": "pvsg-conv-gt-adapt-v1",
    "original_benchmark_replication_id": "openpvsg-ips-conv-repro-v1"
  },
  "execution": {
    "m0_downloads": "annotation_metadata_and_research_sources_only",
    "training_enabled": false,
    "trainable_components_future": ["object_projection", "relation_graph", "relation_heads"],
    "full_training_wandb": "required",
    "full_training_operator": "user",
    "concurrent_models": 1,
    "automatic_next_run": false
  }
}
